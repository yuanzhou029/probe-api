# probe-api 环境变量，安装到 /etc/probe-api.env（chmod 600）
# 改动后：sudo systemctl restart probe-api

PORT=8787
HOST=0.0.0.0

# 公网暴露必须改掉；留空表示不鉴权
PROBE_TOKEN=CHANGE_ME

BATCH_LIMIT=200
CONCURRENCY=20

# 探测目标（默认 www.iplocate.io 的 /api/lookup，返回 JSON 含 ip 字段）
TARGET_HOST=www.iplocate.io
TARGET_PORT=443
TARGET_PATH=/api/lookup

CHECK_TIMEOUT_MS=12000
CONNECT_TIMEOUT_MS=9999
READ_TIMEOUT_MS=8000
MAX_RESPONSE_BYTES=98304
